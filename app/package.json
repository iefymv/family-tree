{
  "name": "family-tree-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:e2e": "playwright test",
    "preview:local": "node scripts/with-local-env.mjs npx vite build && npx vite preview --port 4173 --strictPort",
    "showcase:logins": "node scripts/showcase-logins.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "d3-dag": "1.2.2",
    "d3-interpolate": "3.0.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "heic2any": "0.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
